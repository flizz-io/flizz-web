# Absolute origin of the deployed site, no trailing slash. Used for canonical
# URLs, Open Graph tags, JSON-LD and share links — all of which need an absolute
# URL and cannot be derived at build time.
NEXT_PUBLIC_SITE_URL=https://flizz.io

# `true` → the floating Theme Lab button on every landing page: a browser-only
# colour playground for trying palettes without touching the codebase. Unset
# or anything else → hidden and never downloaded. Inlined at build time —
# restart dev or redeploy after changing it. Keep it off in Production.
NEXT_PUBLIC_ENABLE_THEME_LAB=false

# Playback speed for every landing-page animation (GSAP, CSS, Motion and the
# Three.js scenes). 1 plays them as authored, 0.5 at half speed, 1.5 faster.
# Clamped to 0.1–3; unset or invalid falls back to `defaultAnimationSpeed` in
# constants/animation.ts. Inlined at build time — restart dev after changing.
NEXT_PUBLIC_ANIMATION_SPEED=0.7

# The API's origin, no trailing slash — the portfolio and About pages read
# from it at build time and on revalidation. Required for `next build`.
API_URL=http://localhost:3500

# Only when the API stores media on local disk (MEDIA_PROVIDER=local): the
# API's MEDIA_PUBLIC_BASE_URL, so next/image may load from it. Cloudinary is
# always allowed.
MEDIA_BASE_URL=http://localhost:3500/api/media

# `true` → pages built from the API also refetch every five minutes on their
# own (so a project scheduled for later goes live unaided). Unset or anything
# else → they change only when the API asks, via the secret below. Read at
# build time — rebuild after changing it.
ENABLE_PERIODIC_REVALIDATION=false

# Shared with the API (WEB_REVALIDATE_SECRET). The API sends it to
# POST /api/revalidate after a project or team change, so pages refresh within
# seconds. Unset → the endpoint refuses, and pages change only on their
# interval (if enabled above) or the next deploy.
REVALIDATE_SECRET=

# Crisp chatbox website ID (Crisp → Settings → Workspace Settings → Setup &
# Integrations). Unset or empty → no chatbox. Inlined at build time — restart
# dev or redeploy after changing it.
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Analytics (docs/guides/analytics.md). Both load only after the visitor
# accepts cookies. Set them on the Production environment in Vercel only, so
# previews and local runs never send data. Inlined at build time — redeploy
# after changing one.
# Google Analytics 4 measurement ID (G-…). Unset or empty → no GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID (digits only). Unset or empty → no Pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# Error tracking (Sentry). Leave empty locally; set on the Production
# environment in Vercel only.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time: upload source maps for readable stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Contact page (docs/requirements/contact-page.md#environment-variables).
# The API's public origin, no trailing slash — the browser posts the contact
# form straight to it, so it must be in the API's CORS_ORIGINS list.
NEXT_PUBLIC_API_URL=http://localhost:3500
# Cloudflare Turnstile site key (Cloudflare → Turnstile → the site). Empty →
# no CAPTCHA. Set it together with the API's TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Calendly event link for the booking slot on /contact, e.g.
# https://calendly.com/flizz/discovery-call. Empty → the slot says to email.
NEXT_PUBLIC_CALENDLY_URL=
