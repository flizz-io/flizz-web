# Absolute origin of the deployed site, no trailing slash. Used for canonical
# URLs, Open Graph tags, JSON-LD and share links — all of which need an absolute
# URL and cannot be derived at build time.
NEXT_PUBLIC_SITE_URL=https://flizz.io

# Shows the floating Theme Lab button on landing pages — a browser-only colour
# playground for trying palettes without touching the codebase.
# Leave unset (or anything other than "true") in production.
NEXT_PUBLIC_ENABLE_THEME_LAB=true

# Playback speed for every landing-page animation (GSAP, CSS, Motion and the
# Three.js scenes). 1 plays them as authored, 0.5 at half speed, 1.5 faster.
# Clamped to 0.1–3; unset or invalid falls back to `defaultAnimationSpeed` in
# constants/animation.ts. Inlined at build time — restart dev after changing.
NEXT_PUBLIC_ANIMATION_SPEED=0.7
