# apps/api environment — copy to .env and fill in. Validated at start-up
# (src/configs/env.ts); the server refuses to start with a missing value.

NODE_ENV=development
PORT=3500

# PostgreSQL. Local Unix-socket example (peer auth, no password):
#   postgresql://<os-user>@localhost/flizz?host=/var/run/postgresql
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flizz

# Google OAuth client ID (Google Cloud Console → APIs & Services → Credentials).
# Every ID token must be issued for this client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signs admin session cookies. At least 32 random characters — e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
SESSION_SECRET=

# The one Super Admin (their Google account). `pnpm --filter api db:seed`
# creates or promotes them, demoting any previous Super Admin to Admin. Every
# other user is added from the dashboard's Team screen.
SUPER_ADMIN_EMAIL=you@example.com

# Public-site origins allowed to read public endpoints cross-origin,
# comma-separated. The dashboard needs none — it proxies /api itself.
CORS_ORIGINS=http://localhost:3300

# Uploaded files (packages/media-library). `cloudinary` (default) or `local`.
# Setup and switching: docs/guides/media-storage.md
MEDIA_PROVIDER=cloudinary

# Cloudinary (free tier) — Console → Settings → API Keys. Required when
# MEDIA_PROVIDER=cloudinary. Uploads go under CLOUDINARY_FOLDER.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flizz

# Local disk — only with MEDIA_PROVIDER=local (offline development). The
# directory is relative to apps/api and served by the API at /api/media.
MEDIA_STORAGE_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3500/api/media

# The public site (apps/web), no trailing slash, and the secret it expects on
# POST /api/revalidate (its REVALIDATE_SECRET). After a project or team
# change the API asks it to refresh those pages, so edits show within
# seconds. Leave either empty to skip — pages then refresh on their interval.
WEB_URL=http://localhost:3300
WEB_REVALIDATE_SECRET=
