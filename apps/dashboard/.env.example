# apps/dashboard environment — copy to .env.local and fill in.

# Where the dashboard's /api/* rewrite forwards to (server-side only).
API_URL=http://localhost:3500

# The same Google OAuth client ID the API checks tokens against. The client's
# "Authorised JavaScript origins" must include this dashboard's origin
# (http://localhost:3400 in development).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
