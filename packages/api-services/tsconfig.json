{
	"extends": "@workspace/typescript-config/base.json",
	"compilerOptions": {
		// Consumed through Next's `transpilePackages`, so resolution has to match
		// a bundler — the NodeNext default would demand `.js` extensions on
		// relative imports.
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
