{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV", "PORT"],
	"globalPassThroughEnv": [
		"CI",
		"E2E_WEB_URL",
		"E2E_DASHBOARD_URL",
		"E2E_API_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": [
				"DATABASE_URL",
				"API_URL",
				"MEDIA_BASE_URL",
				"REVALIDATE_SECRET",
				"ENABLE_PERIODIC_REVALIDATION",
				"NEXT_PUBLIC_GOOGLE_CLIENT_ID",
				"SENTRY_AUTH_TOKEN",
				"SENTRY_ORG",
				"SENTRY_PROJECT"
			],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
